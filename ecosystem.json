{
  "schema": 1,
  "owner": "elchemista",
  "orchestrator": {
    "repository": "elchemista/spectre_ecosystem",
    "default_ref": "master",
    "workflow": "compatibility.yml",
    "satellite_workflow": "spectre-compatibility.yml"
  },
  "runtime": {
    "max_parallel": 4
  },
  "core": {
    "name": "spectre",
    "repository": "elchemista/spectre",
    "default_ref": "main"
  },
  "profiles": ["compat", "full"],
  "packages": [
    {
      "name": "spectre_beam",
      "repository": "elchemista/spectre_beam",
      "default_ref": "main",
      "dependencies": ["spectre"],
      "timeout_minutes": 35
    },
    {
      "name": "spectre_directive",
      "repository": "elchemista/spectre_directive",
      "default_ref": "main",
      "dependencies": ["spectre"],
      "timeout_minutes": 35
    },
    {
      "name": "spectre_kinetic",
      "repository": "elchemista/spectre_kinetic",
      "default_ref": "main",
      "dependencies": ["spectre"],
      "timeout_minutes": 50
    },
    {
      "name": "spectre_lab",
      "repository": "elchemista/spectre_lab",
      "default_ref": "master",
      "dependencies": ["spectre", "spectre_ledger"],
      "timeout_minutes": 45
    },
    {
      "name": "spectre_ledger",
      "repository": "elchemista/spectre_ledger",
      "default_ref": "master",
      "dependencies": ["spectre"],
      "timeout_minutes": 50
    },
    {
      "name": "spectre_lens",
      "repository": "elchemista/spectre_lens",
      "default_ref": "main",
      "dependencies": ["spectre"],
      "timeout_minutes": 45
    },
    {
      "name": "spectre_mnemonic",
      "repository": "elchemista/spectre_mnemonic",
      "default_ref": "main",
      "dependencies": ["spectre"],
      "timeout_minutes": 50
    },
    {
      "name": "spectre_prism",
      "repository": "elchemista/spectre_prism",
      "default_ref": "main",
      "dependencies": ["spectre"],
      "timeout_minutes": 35
    },
    {
      "name": "spectre_pulse",
      "repository": "elchemista/spectre_pulse",
      "default_ref": "main",
      "dependencies": [
        "spectre",
        "spectre_beam",
        "spectre_directive",
        "spectre_kinetic",
        "spectre_lens",
        "spectre_mnemonic",
        "spectre_prism"
      ],
      "timeout_minutes": 50
    }
  ]
}
